# Local single-user synthetic demo. Never expose this backend publicly.
DATABASE_URL=sqlite:///./.runtime/moniq.db
MODEL_DIR=./.runtime/models
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional local-owner Gmail connection. Never use these in a public demo.
PERSONAL_DATABASE_URL=sqlite:///./.runtime/personal.db
PERSONAL_MODEL_DIR=./.runtime/personal-models
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Run: .\.venv\Scripts\python.exe scripts\configure-gmail-key.py
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback
GMAIL_FRONTEND_URL=http://127.0.0.1:5173
GMAIL_TOKEN_DIR=./.runtime/gmail
# Isolated, explicit SmartApprove + Circles synthetic walkthrough; never shares Gmail storage.
SCENARIO_DATABASE_URL=sqlite:///./.runtime/upgrade-scenario.db
# Future provider adapters (not required):
GEMINI_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Set true only for isolated recording/testing servers to disable Gmail credentials.
MONIQ_GMAIL_DISABLED=false
