# Local single-user synthetic demo. Never expose this backend publicly.
DATABASE_URL=sqlite:///./.runtime/moniq.db
MODEL_DIR=./.runtime/models
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional local-owner Gmail connection. Never use these in a public demo.
PERSONAL_DATABASE_URL=sqlite:///./.runtime/personal.db
PERSONAL_MODEL_DIR=./.runtime/personal-models
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Run: .\.venv\Scripts\python.exe scripts\configure-gmail-key.py
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback
GMAIL_FRONTEND_URL=http://127.0.0.1:5173
GMAIL_TOKEN_DIR=./.runtime/gmail
# Isolated, explicit SmartApprove + Circles synthetic walkthrough; never shares Gmail storage.
SCENARIO_DATABASE_URL=sqlite:///./.runtime/upgrade-scenario.db
# Future provider adapters (not required):
GEMINI_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Set true only for isolated recording/testing servers to disable Gmail credentials.
MONIQ_GMAIL_DISABLED=false

# Hosted private application: opt-in; never reuse the local owner's Gmail vault.
# Existing render.yaml keeps all of this disabled. See docs/HOSTED_PRIVATE_SETUP.md.
MONIQ_HOSTED_APP=false
MONIQ_PUBLIC_ORIGIN=https://moniq-80su.onrender.com
MONIQ_PRIVATE_ACCOUNTS_ENABLED=false
HOSTED_DATABASE_URL=
MONIQ_SESSION_SIGNING_KEY=
# Set these true only after a PostgreSQL restore/restart drill and email recovery test.
MONIQ_PERSISTENCE_VERIFIED=false
MONIQ_RECOVERY_VERIFIED=false
# Explicit invitation-only test addresses, comma-separated; never in frontend code.
MONIQ_TEST_USER_EMAILS=
MONIQ_SMTP_HOST=
MONIQ_SMTP_PORT=465
MONIQ_SMTP_USER=
MONIQ_SMTP_PASSWORD=
MONIQ_MAIL_FROM=
# Render Free blocks SMTP ports. Optional HTTPS Resend transport; no provider created.
MONIQ_MAIL_TRANSPORT=smtp
MONIQ_MAIL_API_KEY=
MONIQ_HOSTED_GMAIL_ENABLED=false
HOSTED_GMAIL_CLIENT_ID=
HOSTED_GMAIL_CLIENT_SECRET=
HOSTED_GMAIL_TOKEN_ENCRYPTION_KEY=
